// Numeric Constants & Identifiers DFA
digraph {
	graph [margin=0.02 nodesep=0.2 rankdir=LR ranksep=0.3]
	node [fontsize=9 height=0.25 margin=0.03 width=0.25]
	edge [arrowsize=0.6 fontsize=8]
	0 [label=0 fillcolor=gold shape=doublecircle style=filled]
	-1 [label="-1
(Identifier)" fillcolor=lightblue shape=box style=filled]
	-2 [label="-2
(Binary Constant)" fillcolor=lightgreen shape=box style=filled]
	-3 [label="-3
(Decimal Constant)" fillcolor=khaki shape=box style=filled]
	-4 [label="-4
(Octal Constant)" fillcolor=lightpink shape=box style=filled]
	-5 [label="-5
(Hexadecimal Constant)" fillcolor=plum shape=box style=filled]
	1 [label=1 shape=circle]
	2 [label=2 shape=circle]
	3 [label=3 shape=circle]
	4 [label=4 shape=circle]
	5 [label=5 shape=circle]
	6 [label=6 shape=circle]
	7 [label=7 shape=circle]
	8 [label=8 shape=circle]
	9 [label=9 shape=circle]
	0 -> 1 [label=" 0 "]
	0 -> 2 [label=" 1, 2..7, 89 "]
	0 -> 3 [label=" else "]
	1 -> 2 [label=" 0, 1, 2..7, 89 "]
	1 -> 4 [label=" bB "]
	1 -> 5 [label=" xX "]
	1 -> 6 [label=" oO "]
	1 -> -3 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	2 -> 2 [label=" 0, 1, 2..7, 89 "]
	2 -> -3 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	3 -> 3 [label=" else "]
	3 -> -1 [label=" other " color=gray30 fontcolor=gray20 style=dashed]
	4 -> 7 [label=" 0, 1 "]
	4 -> -3 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	5 -> 8 [label=" 0, 1, 2..7, 89, bB, a-f, A-F "]
	5 -> -3 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	6 -> 9 [label=" 0, 1, 2..7 "]
	6 -> -3 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	7 -> 7 [label=" 0, 1 "]
	7 -> -2 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	8 -> 8 [label=" 0, 1, 2..7, 89, bB, a-f, A-F "]
	8 -> -5 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	9 -> 9 [label=" 0, 1, 2..7 "]
	9 -> -4 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
}
