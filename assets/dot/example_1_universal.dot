// Keywords and Numbers DFA
digraph {
	graph [margin=0.02 nodesep=0.2 rankdir=TB ranksep=0.3]
	node [fontsize=9 height=0.25 margin=0.03 width=0.25]
	edge [arrowsize=0.6 fontsize=8]
	0 [label=0 fillcolor=gold shape=doublecircle style=filled]
	-1 [label="-1
(Keyword (go))" fillcolor=lightgreen shape=box style=filled]
	-2 [label="-2
(Keyword (goon))" fillcolor=mediumseagreen shape=box style=filled]
	-3 [label="-3
(Keyword (open))" fillcolor=lightblue shape=box style=filled]
	-4 [label="-4
(Keyword (online))" fillcolor=skyblue shape=box style=filled]
	-5 [label="-5
(Number)" fillcolor=khaki shape=box style=filled]
	1 [label=1 shape=circle]
	2 [label=2 shape=circle]
	3 [label=3 shape=circle]
	4 [label=4 shape=circle]
	5 [label=5 shape=circle]
	6 [label=6 shape=circle]
	7 [label=7 shape=circle]
	8 [label=8 shape=circle]
	9 [label=9 shape=circle]
	10 [label=10 shape=circle]
	11 [label=11 shape=circle]
	12 [label=12 shape=circle]
	13 [label=13 shape=circle]
	14 [label=14 shape=circle]
	0 -> 1 [label=" 0..9 "]
	0 -> 2 [label=" g "]
	0 -> 5 [label=" o "]
	1 -> 1 [label=" 0..9 "]
	1 -> -5 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	2 -> 3 [label=" o "]
	3 -> -1 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	3 -> 4 [label=" o "]
	4 -> -1 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	4 -> 10 [label=" n "]
	5 -> 6 [label=" p "]
	5 -> 8 [label=" n "]
	6 -> 7 [label=" e "]
	7 -> 11 [label=" n "]
	8 -> 9 [label=" l "]
	9 -> 12 [label=" i "]
	10 -> -2 [label=" 0..9, g, o, p, e, n, l, i, other " color=gray30 fontcolor=gray20 style=dashed]
	11 -> -3 [label=" 0..9, g, o, p, e, n, l, i, other " color=gray30 fontcolor=gray20 style=dashed]
	12 -> 13 [label=" n "]
	13 -> 14 [label=" e "]
	14 -> -4 [label=" 0..9, g, o, p, e, n, l, i, other " color=gray30 fontcolor=gray20 style=dashed]
}
