// Nested Keywords DFA (Multi-Level Backtracking)
digraph {
	graph [margin=0.02 nodesep=0.2 rankdir=TB ranksep=0.3]
	node [fontsize=9 height=0.25 margin=0.03 width=0.25]
	edge [arrowsize=0.6 fontsize=8]
	0 [label=0 fillcolor=gold shape=doublecircle style=filled]
	-1 [label="-1
(Keyword (in))" fillcolor=lightblue shape=box style=filled]
	-2 [label="-2
(Keyword (int))" fillcolor=lightgreen shape=box style=filled]
	-3 [label="-3
(Keyword (integer))" fillcolor=mediumseagreen shape=box style=filled]
	-4 [label="-4
(Keyword (to))" fillcolor=khaki shape=box style=filled]
	-5 [label="-5
(Keyword (topic))" fillcolor=plum shape=box style=filled]
	1 [label=1 shape=circle]
	2 [label=2 shape=circle]
	3 [label=3 shape=circle]
	4 [label=4 shape=circle]
	5 [label=5 shape=circle]
	6 [label=6 shape=circle]
	7 [label=7 shape=circle]
	8 [label=8 shape=circle]
	9 [label=9 shape=circle]
	10 [label=10 shape=circle]
	11 [label=11 shape=circle]
	12 [label=12 shape=circle]
	0 -> 1 [label=" i "]
	0 -> 7 [label=" t "]
	1 -> 2 [label=" n "]
	2 -> -1 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	2 -> 3 [label=" t "]
	3 -> -2 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	3 -> 4 [label=" e "]
	4 -> -2 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	4 -> 5 [label=" g "]
	5 -> -2 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	5 -> 6 [label=" e "]
	6 -> -2 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	6 -> 12 [label=" r "]
	7 -> 8 [label=" o "]
	8 -> -4 [label=" else " color=gray30 fontcolor=gray20 style=dashed]
	8 -> 9 [label=" p "]
	9 -> 10 [label=" i "]
	9 -> -4 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	10 -> -4 [label=" else " color=darkorange fontcolor=darkorange style=dashed]
	10 -> 11 [label=" c "]
	11 -> -5 [label=" i, n, t, e, g, r, o, p, c, other " color=gray30 fontcolor=gray20 style=dashed]
	12 -> -3 [label=" i, n, t, e, g, r, o, p, c, other " color=gray30 fontcolor=gray20 style=dashed]
}
